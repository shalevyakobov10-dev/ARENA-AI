# ============================================================
#  PMMB — Polymarket Momentum Bot — secrets
#  העתק ל-.env ומלא. ה-.env לא נכנס ל-git.
# ============================================================

# --- מסחר אמיתי בלבד (execution.mode: live) ---
# המפתח הפרטי של ארנק ה-EOA/Proxy שמחזיק את ה-USDC.e
PMMB_PRIVATE_KEY=

# כתובת ה-funder: כתובת ה-proxy wallet (אם משתמשים ב-Polymarket UI account)
# אם הארנק הוא EOA רגיל שממנו חותמים — השאר ריק
PMMB_FUNDER_ADDRESS=

# חתימת ה-API של Polymarket (נוצר פעם אחת ע"י scripts/create_api_keys.py)
PMMB_API_KEY=
PMMB_API_SECRET=
PMMB_API_PASSPHRASE=

# סיסמת מעטפת להפעלת live — הבוט מסרב לרוץ בלי זה (הגנה מפני הרצה בטעות)
PMMB_LIVE_CONFIRM=

# --- הגנת דשבורד / API (חובה כאשר מאזינים מחוץ ל-loopback) ---
# צור סוד אקראי ארוך; אל תשתף אותו ואל תכניס אותו ל-Git.
PMMB_STATUS_TOKEN=

# --- אופציונלי ---
# webhook להתראות (Slack/Discord) על פקודות ועצירות חירום
PMMB_ALERT_WEBHOOK=
