# דוגמת crontab להרצת paper לאורך שבועות + דוח יומי
# התקנה:  crontab -e   והדבק את השורות (עם נתיב אמיתי)

# 1) הפעלה מחדש של הבוט אם הוא נפל (כל 5 דקות)
*/5 * * * * cd /opt/polymarket-momentum-bot && pgrep -f "pmmb paper" > /dev/null || ./scripts/run_paper.sh >> logs/watchdog.log 2>&1

# 2) דוח יומי ב-07:05 UTC
5 7 * * * cd /opt/polymarket-momentum-bot && /usr/local/bin/pmmb daily >> logs/daily.log 2>&1

# 3) גיבוי ה-DB פעם ביום
30 3 * * * cd /opt/polymarket-momentum-bot && cp pmmb.db backups/pmmb-$(date +\%Y\%m\%d).db
